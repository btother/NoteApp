<Window x:Class="NoteApp.Views.RenameDialog"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Umbenennen"
Width="360" Height="160"
WindowStartupLocation="CenterOwner"
ResizeMode="NoResize"
Background="#1E1E2E"
Foreground="#E0E0F0">
    <Grid Margin="20">
    <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="12"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="16"/>
    <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

              
        <TextBlock Grid.Row="0" Text="Neuer Name:" Foreground="#9090B0" FontSize="12"/>

        <TextBox Grid.Row="2" x:Name="NameBox"
                 FontSize="14"
                 Background="#2E2E45"
                 Foreground="#E0E0F0"
                 BorderBrush="#3A3A55"
                 BorderThickness="1"
                 Padding="8,6"
                 KeyDown="NameBox_KeyDown"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abbrechen" Width="90" Margin="0,0,8,0"
                    Background="#2E2E45" Foreground="#9090B0"
                    BorderThickness="0" Padding="10,6"
                    Cursor="Hand" Click="Cancel_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="OK" Width="80"
                    Background="#7C6AF7" Foreground="#E0E0F0"
                    BorderThickness="0" Padding="10,6"
                    Cursor="Hand" Click="Ok_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>

        

</Window> 